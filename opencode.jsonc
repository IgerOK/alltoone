{
  "$schema": "https://opencode.ai/config.json",
  // Keep more exact recent context than the 15k default: compaction is lossy,
  // and the handoff protocol only helps if the tail is still readable.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 30000,
    },
    "buffer": 20000,
  },
  // Write the summary ahead of time instead of pausing the session.
  "experimental": {
    "background_compaction": true,
  },
  // Context meter. Options reach the plugin only through this entry; the
  // `.opencode/plugins/` discovery and this path resolve to one instance.
  // `autoCompact` stays off: compaction is lossy, a new chat with /resume is
  // the intended exit.
  "plugins": [
    {
      "package": "./.opencode/plugins/context-budget",
      "options": {
        "autoCompact": false,
      },
    },
  ],
}
