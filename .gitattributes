# Shell scripts must keep LF endings to stay runnable after a checkout on any OS.
*.sh text eol=lf
*.ps1 text eol=crlf

# The license is read outside an editor and travels into other repositories:
# pin it to LF so a Windows checkout cannot turn it into CRLF.
LICENSE text eol=lf

# `git archive` is the install-only snapshot: development material stays out.
.github/ export-ignore
tests/ export-ignore
RELEASING.md export-ignore
scripts/usage.py export-ignore
.opencode/handoff/ export-ignore
.opencode/skills/powershell-native-stderr/ export-ignore
